{
  "name": "neom-line-what-if",
  "version": "0.1.0",
  "private": true,
  "description": "사우디 네옴시티 '더 라인', 진짜로 지어졌다면? — Remotion 모션그래픽 영상",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/neom-line.mp4",
    "thumbnail": "remotion still src/index.ts Thumbnail out/thumbnail.png",
    "scaffold": "node tools/scaffold-scenes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "master": "npx remotion ffmpeg -y -hide_banner -loglevel error -i out/neom-line.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 192k -movflags +faststart out/neom-line-master.mp4",
    "review": "python3 tools/review-frames.py out/neom-line.mp4 out/review-full"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@remotion/cli": "^4.0.529",
    "@remotion/transitions": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.529",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.3"
  }
}
